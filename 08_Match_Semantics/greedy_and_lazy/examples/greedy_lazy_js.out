subject       <b>bold</b>
  <.+>      first "<b>bold</b>"  all ["<b>bold</b>"]  stripped ""
  <.+?>     first "<b>"  all ["<b>","</b>"]  stripped "bold"
  <[^>]+>   first "<b>"  all ["<b>","</b>"]  stripped "bold"
subject       aaa
  a+        first "aaa"
  a+?       first "a"
  a*?       first ""
  a{1,3}?   first "a"
subject       name="ada", role="pilot"
  "(.*)"    group 1 "ada\", role=\"pilot"
  "(.*?)"   group 1 "ada"
  "([^"]*)" group 1 "ada"
subject       name="ada", role="pilot"
  name=.*   match   "name=\"ada\", role=\"pilot\""
  name=.*?  match   "name="
  name=.*$  match   "name=\"ada\", role=\"pilot\""
  name=.*?$ match   "name=\"ada\", role=\"pilot\""

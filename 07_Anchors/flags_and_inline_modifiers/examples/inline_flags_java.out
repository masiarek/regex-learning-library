== the dot: what it excludes ==
subject "one\ntwo"
  one.two                        no match
  one.two  DOTALL                match "one\ntwo"
  (?s)one.two                    match "one\ntwo"
subject "one\rtwo"
  one.two                        no match
  one.two  UNIX_LINES            match "one\rtwo"
== the letter m: line anchors ==
subject "one\ntwo\nthree"
  ^two$                          no match
  ^two$  MULTILINE               match "two"
  (?m)^two$                      match "two"
  one.two  MULTILINE             no match
subject "abc\r\ndef"
  ^abc$  (?m)                    match "abc"
  ^abc$  (?m)(?d)                no match
== free-spacing: COMMENTS / (?x) ==
  one line                       match "2026-09-22"
  (?x)                           match "2026-09-22"
  a b   (?x)  on "a b"           no match
  a b   (?x)  on "ab"            match "ab"
  a\ b  (?x)  on "a b"           match "a b"
  a#b   (?x)  on "a#b"           match "a"
== inline and scoped modifiers ==
  abc            on ABC          no match
  abc  CASE_INSENSITIVE          match "ABC"
  (?i)abc        on ABC          match "ABC"
  (?i:b)c        on Bc           match "Bc"
  (?i:b)c        on bC           no match
  (?i)ab(?-i:cd) on ABcd         match "ABcd"
  (?i)ab(?-i:cd) on ABCD         no match
  a(?i)bc        on aBC          match "aBC"
  a(?i)bc        on ABC          no match
  (a(?i)b)c      on aBc          match "aBc"
  (a(?i)b)c      on abC          no match
